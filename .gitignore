# pyenv
#   For a library or package, you might want to ignore these files since the code is
#   intended to run in multiple environments; otherwise, check them in:
# .python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, in case of collaboration, if hopes is to let users install dependency in their own way,
#   Pipfile.lock can be ignored.
# - http://pipenv.kennethreitz.org/en/latest/user/using-pipenv/#pipenv-and-version-control
#Pipfile.lock

# poetry
#   Similar to Pipfile.lock, poetry.lock can be ignored or included in version control.
#poetry.lock

# pdm
#   Similar to Pipfile.lock, pdm.lock can be ignored or included in version control.
#pdm.lock

# virtualenv
.env
env/
venv/
ENV/
env.bak/
venv.bak/

